# URL base del Backend en Express (usa la URL de producción al desplegar)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# IDs de usuarios administradores separados por comas (sincronizado con ADMIN_USER_IDS del backend)
VITE_ADMIN_USER_IDS=1

# Frecuencia de Polling HTTP del panel (en milisegundos)
VITE_PANEL_POLL_INTERVAL_MS=2500

# Frecuencia del ciclo de Heartbeat periódico de NinjaTrader (en milisegundos)
VITE_NINJA_HEARTBEAT_INTERVAL_MS=4000
